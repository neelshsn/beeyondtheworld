:\"label-method\",\"title\":\"The Bee Label / review framework\",\"fr\":\"Bee Label · référentiel et décision\",\"stage\":11,\"role\":\"expert\",\"phase\":\"Mesure et revue indépendante\",\"mode\":\"read\",\"v2\":\"email-method\",\"note\":\"Ébauche interactive du 15 octobre 2026. Simulation locale ; feedback partagé sur le VPS.\",\"action\":\"Explorer les connexions\",\"fields\":[]},{\"id\":\"label-method\",\"title\":\"The Bee Label / review framework\",\"fr\":\"Bee Label · référentiel et décision\",\"stage\":11,\"role\":\"production\",\"phase\":\"Mesure et revue indépendante\",\"mode\":\"read\",\"v2\":\"email-method\",\"note\":\"Ébauche interactive du 15 octobre 2026. Simulation locale ; feedback partagé sur le VPS.\",\"action\":\"Explorer les connexions\",\"fields\":[]},{\"id\":\"label-method\",\"title\":\"The Bee Label / review framework\",\"fr\":\"Bee Label · référentiel et décision\",\"stage\":11,\"role\":\"art\",\"phase\":\"Mesure et revue indépendante\",\"mode\":\"edit\",\"v2\":\"email-method\",\"note\":\"Ébauche interactive du 15 octobre 2026. Simulation locale ; feedback partagé sur le VPS.\",\"action\":\"Explorer les connexions\",\"fields\":[]},{\"id\":\"label-method\",\"title\":\"The Bee Label / review framework\",\"fr\":\"Bee Label · référentiel et décision\",\"stage\":11,\"role\":\"brand\",\"phase\":\"Mesure et revue indépendante\",\"mode\":\"read\",\"v2\":\"email-method\",\"note\":\"Ébauche interactive du 15 octobre 2026. Simulation locale ; feedback partagé sur le VPS.\",\"action\":\"Explorer les connexions\",\"fields\":[]}],\"guides\":{\"stages\":[{\"id\":0,\"title\":\"Accès et espace personnel\",\"when\":\"Avant le brief\",\"owner\":\"Bee attribue les accès\",\"handoff\":\"Chaque membre retrouve uniquement ses projets et prépare son profil.\",\"decision\":\"Le rôle détermine les écrans et les actions disponibles.\"},{\"id\":1,\"title\":\"Brief de la marque\",\"when\":\"19-23 octobre\",\"owner\":\"Marque vers Bee et direction artistique\",\"handoff\":\"Un brief complet : intention, personnes, collection, images, formats, droits et échéance.\",\"decision\":\"Bee vérifie le périmètre avant de lancer la proposition.\"},{\"id\":2,\"title\":\"Confiance du partenaire local\",\"when\":\"En parallèle du brief\",\"owner\":\"Partenaire local vers Bee\",\"handoff\":\"Identité, organisation, gouvernance, compétences et présence locale documentées.\",\"decision\":\"Bee qualifie le partenaire pour un périmètre précis.\"},{\"id\":3,\"title\":\"Création et constitution de l’équipe\",\"when\":\"24-30 octobre\",\"owner\":\"Direction artistique et production vers Bee\",\"handoff\":\"Concept, moodboard, casting, collection, équipe, accords et budget.\",\"decision\":\"Bee examine la création avant la marque ; Bee décide du budget.\"},{\"id\":4,\"title\":\"Scouting : de Bee à Flower\",\"when\":\"2 novembre\",\"owner\":\"Production, DA, photo et film\",\"handoff\":\"Lieux, lumière, accès, plans et affectations des sept disciplines.\",\"decision\":\"Les cadres et looks retenus passent par Bee puis par la marque.\"},{\"id\":5,\"title\":\"Préparation et feu vert\",\"when\":\"3 novembre\",\"owner\":\"Production et métiers plateau\",\"handoff\":\"Itinéraire, réservations, matériel, looks, fitting et continuité beauté.\",\"decision\":\"Aucun départ en production sans création, équipe, accès et budget cohérents.\"},{\"id\":6,\"title\":\"Conception de l’action locale\",\"when\":\"Avant l’action terrain\",\"owner\":\"Partenaire local et Bee\",\"handoff\":\"Un atelier pour 12 adultes et un suivi de 60 pots, avec un budget séparé de 2 500 EUR.\",\"decision\":\"Bee valide le plan et la méthode ; l’expert intervient selon le risque.\"},{\"id\":7,\"title\":\"Flower : la production\",\"when\":\"4-6 novembre\",\"owner\":\"Production, DA et équipe image\",\"handoff\":\"Feuille de service, prises, previews, backstage, dépenses, sauvegardes et brief de postproduction.\",\"decision\":\"On suit les versions, les raccords, les justificatifs et les incidents.\"},{\"id\":8,\"title\":\"Action terrain et pièces\",\"when\":\"6 novembre\",\"owner\":\"Partenaire local vers Bee\",\"handoff\":\"Avancement, dépenses et registres de l’action rattachés au même dossier.\",\"decision\":\"Une image IA illustre l’action ; elle ne remplace jamais une preuve terrain.\"},{\"id\":9,\"title\":\"Montage, retouche et validations\",\"when\":\"9-16 novembre\",\"owner\":\"Montage et retouche vers Bee, puis marque\",\"handoff\":\"Sélection, V01, retours précis, V02 et décision sur la bonne révision.\",\"decision\":\"Si la source change, les validations liées doivent être réexaminées.\"},{\"id\":10,\"title\":\"Livraison et archivage\",\"when\":\"20 novembre\",\"owner\":\"Postproduction et Bee vers marque\",\"handoff\":\"12 photos, 6 exports vidéo, manifeste de fichiers, droits et dossier d’archive.\",\"decision\":\"Une livraison ne vaut ni publication publique ni extension des droits.\"},{\"id\":11,\"title\":\"Mesure et revue indépendante\",\"when\":\"6-10 décembre\",\"owner\":\"Partenaire local, Bee et expert attribué\",\"handoff\":\"Dans l’exercice : 54 pots vivants sur 60, soit 90 % à J+30 ; cohorte et méthode explicites.\",\"decision\":\"Ne pas déduire une restauration d’hectares ou un gain de biodiversité de ce seul comptage.\"},{\"id\":12,\"title\":\"Honey : bilan et prochaine production\",\"when\":\"Après réconciliation\",\"owner\":\"Bee vers marque et équipe\",\"handoff\":\"Création, dépenses, activité de production, résultats admis et enseignements réunis.\",\"decision\":\"Les montants et mesures de ce dossier sont fictifs ; aucune allégation réelle n’est publiée.\"}],\"roles\":{\"brand\":{\"file\":\"01-marque\",\"cover\":\"film-detail\",\"receive\":\"Les propositions et versions que Bee a déjà examinées.\",\"give\":\"Un brief exploitable et des décisions créatives précises sur la révision reçue.\",\"focus\":\"Exprimer le besoin, choisir les images, confirmer les droits et recevoir les masters.\",\"limit\":\"La marque ne pilote pas les réservations internes ni les preuves sensibles du partenaire.\"},\"bee\":{\"file\":\"02-bee-coordination\",\"cover\":\"on-set\",\"receive\":\"Les dossiers préparés par la marque, la DA, la production, le partenaire et la postproduction.\",\"give\":\"Les arbitrages, le budget, les autorisations et le dossier final réconcilié.\",\"focus\":\"Relier les métiers et vérifier que chaque promesse correspond à une décision ou une pièce.\",\"limit\":\"Un statut approuvé dans l’outil ne déclenche aucun paiement ni publication automatique.\"},\"art\":{\"file\":\"03-direction-artistique\",\"cover\":\"film-detail\",\"receive\":\"L’intention de marque, la collection et les contraintes de production.\",\"give\":\"Une direction cohérente, des plans précis et un brief de retouche ou de montage.\",\"focus\":\"Préserver le fil visuel : lumière naturelle, cuir lisible, matière et mouvement.\",\"limit\":\"La DA prépare la proposition ; la validation suit Bee puis la marque.\"},\"production\":{\"file\":\"04-direction-production\",\"cover\":\"on-set\",\"receive\":\"Le brief, les cadres approuvés, le budget autorisé et les disponibilités.\",\"give\":\"Un planning réaliste, une équipe prête, les accès, réservations et sources organisées.\",\"focus\":\"Faire arriver la bonne personne, le bon produit et le bon matériel au bon endroit.\",\"limit\":\"La production propose les dépenses ; Bee garde la décision budgétaire.\"},\"stylist\":{\"file\":\"05-stylisme\",\"cover\":\"fitting\",\"receive\":\"Les quatre pièces, les deux looks, les cadres et la présence du talent.\",\"give\":\"Les looks ajustés, l’inventaire, les références de raccord et les retours de collection.\",\"focus\":\"L01 Ivory et L02 Rust partagent le même sac CM-01 ; vérifier le placement de la sangle.\",\"limit\":\"Les mesures privées du talent ne sont pas diffusées dans le dossier collectif.\"},\"photo\":{\"file\":\"06-photographie\",\"cover\":\"on-set\",\"receive\":\"Les plans, la lumière repérée, le produit prioritaire et les usages prévus.\",\"give\":\"Les sources, 24 candidats de sélection puis les 12 photos finales attendues.\",\"focus\":\"Alterner quatre images héros, quatre mouvements et quatre détails lisibles.\",\"limit\":\"Une photographie de campagne est un livrable créatif, pas une preuve d’impact.\"},\"film\":{\"file\":\"07-film-realisation\",\"cover\":\"film-detail\",\"receive\":\"Le brief film, les cadres, les gestes produit et les contraintes son.\",\"give\":\"Les rushes organisés et les intentions pour trois films de 15 secondes.\",\"focus\":\"Prévoir les zones utiles aux versions 9:16 et 4:5 dès la prise de vue.\",\"limit\":\"Les visuels du dossier représentent les films ; aucun rush ou film réel n’est fabriqué ici.\"},\"beauty\":{\"file\":\"08-maquillage-coiffure\",\"cover\":\"beauty-prep\",\"receive\":\"Les deux looks, la lumière, les références et les horaires de préparation.\",\"give\":\"Les références beauté, les raccords et les ajustements prêts pour le plateau.\",\"focus\":\"Conserver la texture de peau et le mouvement des cheveux malgré le vent.\",\"limit\":\"Partager seulement les informations personnelles nécessaires à la préparation.\"},\"editor\":{\"file\":\"09-montage-retouche\",\"cover\":\"film-detail\",\"receive\":\"Les sources classées, la sélection, les références et les formats du brief approuvé.\",\"give\":\"V01, V02, les corrections documentées, les masters et leur manifeste.\",\"focus\":\"Réduire la dominante orange sans effacer le grain du cuir ou les fibres du lin.\",\"limit\":\"Une validation porte sur une révision ; elle ne se transfère pas à un nouveau fichier.\"},\"model\":{\"file\":\"10-talent-mannequin\",\"cover\":\"fitting\",\"receive\":\"Sa mission, son accord, son fitting, ses déplacements et sa feuille de service.\",\"give\":\"Ses disponibilités et les confirmations nécessaires à une présence préparée.\",\"focus\":\"Camille R. est un personnage fictif ; le dossier montre un rôle, pas une personne réelle.\",\"limit\":\"Le talent n’administre pas les budgets, le casting d’autrui ou les validations d’impact.\"},\"ngo\":{\"file\":\"11-partenaire-local\",\"cover\":\"local-workshop\",\"receive\":\"Un périmètre d’action, un budget séparé et une méthode de suivi convenue.\",\"give\":\"Les informations de confiance, les activités, dépenses, registres et mesures du périmètre.\",\"focus\":\"Suivre les mêmes 60 pots et compter les 12 participants sans doublons.\",\"limit\":\"Le partenaire voit son organisation ; les pièces sensibles restent restreintes.\"},\"expert\":{\"file\":\"12-expert-independant\",\"cover\":\"local-workshop\",\"receive\":\"Le seul dossier attribué : méthode, cohorte, registre et proposition de résultat.\",\"give\":\"Un avis motivé, une demande de correction ou une validation dans le périmètre examiné.\",\"focus\":\"Vérifier 54 / 60 à J+30 ; contrôler les manquants et les remplacements.\",\"limit\":\"L’expert ne certifie ni la campagne entière, ni les finances, ni une biodiversité non mesurée.\"},\"agency\":{\"focus\":\"Relier le réseau local, les talents, leurs consentements, les looks et les appels de production.\"},\"set\":{\"focus\":\"Relier les décors, les artisans, les matières, les coûts et leur seconde vie.\"},\"sound\":{\"focus\":\"Composer par chapitre à partir de sources sonores traçables et de droits documentés.\"}}},\"pdfs\":[{\"role\":\"brand\",\"label\":\"Marque\",\"file\":\"pdf/01-marque.pdf\",\"screens\":57,\"pages\":61,\"bytes\":21002650,\"index\":[{\"id\":\"projects\",\"title\":\"Tous mes projets\",\"page\":4,\"stage\":0},{\"id\":\"project\",\"title\":\"Vue du projet\",\"page\":5,\"stage\":0},{\"id\":\"inbox\",\"title\":\"À traiter\",\"page\":6,\"stage\":0},{\"id\":\"calendar\",\"title\":\"Calendrier commun\",\"page\":7,\"stage\":0},{\"id\":\"invite\",\"title\":\"Accepter une invitation\",\"page\":8,\"stage\":0},{\"id\":\"profile\",\"title\":\"Profil professionnel\",\"page\":9,\"stage\":0},{\"id\":\"brief-scope\",\"title\":\"Périmètre du brief\",\"page\":10,\"stage\":1},{